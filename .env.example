# Copy to .env (gitignored). process.loadEnvFile() reads it from cwd on start.
# Every var the relay reads is listed below; unset = the default/mode noted.

# --- Server bind (optional; values shown are the defaults) ---
# RELAY_HOST=127.0.0.1
# RELAY_PORT=8787
# In a container bind all interfaces: RELAY_HOST=0.0.0.0 (the Dockerfile sets it).
# On a PaaS (Railway/Heroku) leave RELAY_PORT unset: the relay falls back to
# the platform-injected PORT, which is where the edge + healthcheck probe.

# --- Persistence (Supabase). Both set = devices persist; else in-memory (dev). ---
# Your project's URL (Dashboard -> Project Settings -> API). Production
# credentials belong only in the deployment platform's env, never in a local
# .env.
# SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Server-side only: Dashboard -> Project Settings -> API Keys -> secret key
# (sb_secret_...). Never commit it, never put it in client code or chat.
SUPABASE_SECRET_KEY=

# HMAC key (pepper) for device tokens. REQUIRED whenever SUPABASE_* is set (the
# relay refuses to start without it). The db stores only kid + HMAC(pepper,
# userId+secret) — this pepper is what keeps a leaked row un-guessable, so keep
# it server-side only. Generate:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# DEVICE_KEYS_PEPPER=

# --- Clerk session auth. CLERK_SECRET_KEY set = real JWT verify; unset = MOCK
#     session auth (any/absent token = the mock user with every entitlement —
#     dev only). ---
# Browser-safe publishable key, handed to the pages via GET /api/config.
# Absent = mock mode (pages skip ClerkJS entirely).
# CLERK_PUBLISHABLE_KEY=pk_test_...
# Secret key: authorizes the networkless JWKS verify + selects the instance.
# CLERK_SECRET_KEY=sk_test_...
# Expected `iss`, enforced as a post-verify claim check (pins tokens to your
# instance). Unset = don't check.
# CLERK_ISSUER=https://your-app.clerk.accounts.dev
# `azp` allowlist for browser (ClerkJS) tokens. Unset or "*" = don't check
# (backend-minted tokens carry no azp, so the canary tests leave it unset).
# CLERK_AUTHORIZED_PARTIES=https://app.example.com,http://localhost:3000

# --- Entitlement + free tier (both only meaningful with a required feature) ---
# The Clerk Billing feature slug a session must carry to link a device / open a
# client. Unset = open gate (dev / launch ramp).
# RELAY_REQUIRED_FEATURE=remote
# Free tier for signed-in users WITHOUT the feature (consulted only when
# RELAY_REQUIRED_FEATURE is set):
#   devices: linked-device cap checked at /api/link/approve (0 = disable the
#            free tier entirely -> hard 403/4005 gate for unentitled users).
#   msgs:    routed `send` messages per user per weekly window (anchored to
#            Tuesday 17:00 Europe/Warsaw — see src/usage.ts), metered at /client.
# RELAY_FREE_DEVICES=1
# RELAY_FREE_WEEKLY_MSGS=100

# Burst cap for ALL users (abuse guard, paid included): routed `send` messages
# per user per calendar minute. 0 = disable.
# RELAY_MAX_MSGS_PER_MINUTE=20
